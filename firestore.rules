rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user has admin role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Public Collections - Read-only for published items, write for admin only
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /venues/{venueId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appearances/{appearanceId} {
      // Public users may ONLY read published appearances
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Protected Ingestion & Audit Collections - Admin access ONLY
    match /sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    match /source_fetches/{fetchId} {
      allow read, write: if isAdmin();
    }

    match /observations/{observationId} {
      allow read, write: if isAdmin();
    }

    match /extraction_candidates/{candidateId} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // User Preferences & Favorites Collections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /user_favorites/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /notification_preferences/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
