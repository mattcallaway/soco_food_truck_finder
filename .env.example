# Application Configuration
NEXT_PUBLIC_APP_NAME="SoCo Food Truck Finder"
NEXT_PUBLIC_SERVICE_AREA="Sonoma County, CA"

# Default Map Center (Santa Rosa, CA)
NEXT_PUBLIC_MAP_CENTER_LAT=38.4404
NEXT_PUBLIC_MAP_CENTER_LNG=-122.7141
NEXT_PUBLIC_MAP_ZOOM=11

# Map Provider Configuration (MapLibre style JSON or tile provider)
NEXT_PUBLIC_MAP_TILE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# Server-Side Geocoding API Abstraction
GEOCODING_API_URL="https://nominatim.openstreetmap.org/search"

# Firebase Client Configuration (Optional in development, required in production)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
