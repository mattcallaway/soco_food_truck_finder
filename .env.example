# ─────────────────────────────────────────────────────────────
# SoCo Food Truck Finder — Environment Variables
# Copy this file to .env.local and fill in values as needed.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="SoCo Food Truck Finder"
NEXT_PUBLIC_SERVICE_AREA="Sonoma County, CA"

# ── Data Mode ─────────────────────────────────────────────────
# 'demo' = in-memory seed data, no Firebase needed (default)
# 'firebase' = live Firestore persistence (requires Firebase config below)
NEXT_PUBLIC_DATA_MODE="demo"
DATA_MODE="demo"

# ── Map (MapLibre GL JS) ──────────────────────────────────────
# Default center: Santa Rosa, CA
NEXT_PUBLIC_MAP_CENTER_LAT=38.4404
NEXT_PUBLIC_MAP_CENTER_LNG=-122.7141
NEXT_PUBLIC_MAP_ZOOM=11

# Any MapLibre-compatible style JSON URL.
# Default: CARTO Positron (free, no API key required).
# For production, consider a self-hosted or paid provider.
NEXT_PUBLIC_MAP_TILE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors &copy; <a href='https://carto.com/attributions'>CARTO</a>"

# ── Geocoding (server-side only) ──────────────────────────────
# Nominatim is free but rate-limited. Replace with a paid provider for production.
GEOCODING_API_URL="https://nominatim.openstreetmap.org/search"

# ── SSRF Protection ───────────────────────────────────────────
# Comma-separated allowlist of domains permitted for source fetching.
# Set to '*' to allow all public domains (default for development).
# In production, restrict to known source domains:
# SSRF_ALLOWED_DOMAINS="example.com,another-source.org"
SSRF_ALLOWED_DOMAINS="*"

# ── Firebase Client SDK ───────────────────────────────────────
# Required when NEXT_PUBLIC_DATA_MODE=firebase
# Get these from: Firebase Console → Project Settings → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Admin SDK (SERVER-SIDE ONLY — never exposed to browser) ──────────
# Required for /api/admin/* route authentication and Firestore Admin writes.
# Get these from: Firebase Console → Project Settings → Service accounts → Generate new private key
#
# Option A: Individual fields (recommended for most deployments)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
# Note: paste the full private key including BEGIN/END markers.
# In .env files, newlines must be written as literal \n:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_PRIVATE_KEY=""

# Option B: Full service account JSON as a single string (alternative to Option A)
# Takes precedence over the three individual fields above if set.
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}'
